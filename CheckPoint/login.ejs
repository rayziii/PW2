<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login</title>
    <link rel="shortcut icon" href="./images/queme.jfif" type="image/x-icon">
    <link rel="stylesheet" href="/style.css">

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cherry+Bomb+One&family=Fredoka:wght@300..700&family=Gorditas:wght@400;700&family=Patrick+Hand&family=Roboto:ital,wght@0,100..900;1,100..900&family=Sniglet:wght@400;800&family=Sofadi+One&family=Sour+Gummy:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">

    
</head>
    <body class="pglogin">

        <div class="login">

            <img src="/images/logo.png">

            <form action="/log-in" method="post">
                <h1>Login</h1>
                
                <label for="nome">Nome de Usuário</label>
                <input type="text" placeholder="Usuário" name="nome" id="nome">

                <label for="senha">Senha</label>
                <input type="password" placeholder="Senha" name="senha" id="senha">

                <% if (erro) { %>
                    <p class="erro"><%= erro %></p>
                <% } %>

                <button type="submit">Entrar</button>
                
            </form>
            
        </div>


    </body>
</html>